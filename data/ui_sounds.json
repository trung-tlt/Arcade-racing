{
  "buses": {
    "ui": {
      "setting": "sfx",
      "default": 0.6
    },
    "music": {
      "setting": "music",
      "default": 0.35
    }
  },
  "events": {
    "focus_move": {
      "file": "sfx/ui/ui_move.wav",
      "volume": 0.45,
      "pitchJitter": 0.03
    },
    "confirm": {
      "file": "sfx/ui/ui_select.wav",
      "volume": 0.6
    },
    "back": {
      "file": "sfx/ui/ui_back.wav",
      "volume": 0.6
    },
    "blocked": {
      "file": "sfx/ui/ui_error.wav",
      "volume": 0.4
    },
    "toggle_on": {
      "file": "sfx/ui/ui_toggle_on.wav",
      "volume": 0.5
    },
    "toggle_off": {
      "file": "sfx/ui/ui_toggle_off.wav",
      "volume": 0.5
    },
    "slider_step": {
      "file": "sfx/ui/ui_slider_tick.wav",
      "volume": 0.5,
      "pitchJitter": 0.02
    },
    "screen_transition": {
      "file": "sfx/ui/ui_whoosh.wav",
      "volume": 0.5
    },
    "vehicle_switch": {
      "file": "sfx/ui/ui_car_switch.wav",
      "volume": 0.5,
      "pitchByVehicleType": {
        "car": 1.0,
        "apc8x8": 0.8,
        "bike": 1.3
      }
    },
    "vehicle_confirm": {
      "file": "sfx/ui/ui_car_confirm.wav",
      "volume": 0.7,
      "pitchByVehicleType": {
        "car": 1.0,
        "apc8x8": 0.75,
        "bike": 1.35
      }
    },
    "track_switch": {
      "file": "sfx/ui/ui_track_switch.wav",
      "volume": 0.6
    },
    "start_race": {
      "file": "sfx/ui/ui_start_race.wav",
      "volume": 0.8,
      "then": "fade music out over 1.2 s"
    },
    "title_enter": {
      "file": "sfx/ui/ui_title_sting.wav",
      "volume": 0.7,
      "then": "start menu music"
    },
    "countdown_tick": {
      "file": "sfx/countdown_beep.wav",
      "volume": 0.5
    },
    "countdown_go": {
      "file": "sfx/countdown_go.wav",
      "volume": 0.6
    }
  },
  "music": {
    "menu": {
      "file": "music/menu_loop.ogg",
      "fallback": "music/menu_loop.wav",
      "loop": true,
      "bpm": 112,
      "bars": 8,
      "volume": 0.35,
      "playsOn": ["MENU", "CAR_SELECT", "RACE_SETUP", "RESULTS", "PAUSE (ducked to 40%)"],
      "stopsOn": ["COUNTDOWN"]
    }
  },
  "screenMap": {
    "Loading": {
      "Enter": "title_enter"
    },
    "Title": {
      "↑↓": "focus_move",
      "Enter/R/G/S/C": "confirm",
      "M": "mute music"
    },
    "CarSelect": {
      "←→/A/D/1-9": "vehicle_switch",
      "out of range number": "blocked",
      "Enter": "vehicle_confirm",
      "Esc": "back"
    },
    "RaceSetup": {
      "↑↓": "focus_move",
      "←→ on track row / T": "track_switch",
      "←→ on laps/difficulty, L, D": "toggle_on",
      "value at limit": "blocked",
      "Enter": "start_race",
      "Esc": "back"
    },
    "Countdown": {
      "3,2,1": "countdown_tick",
      "GO": "countdown_go",
      "Esc": "screen_transition"
    },
    "Pause": {
      "↑↓": "focus_move",
      "Resume": "screen_transition",
      "R/S/C/Q": "confirm"
    },
    "Results": {
      "Enter/R": "start_race",
      "C": "screen_transition",
      "M": "confirm"
    },
    "Settings": {
      "↑↓": "focus_move",
      "toggle": "toggle_on / toggle_off",
      "slider/enum": "slider_step",
      "at limit": "blocked",
      "Backspace": "toggle_off",
      "Esc": "back"
    },
    "Controls": {
      "Esc/Backspace": "back"
    }
  },
  "note": "Unlock Web Audio on the first key press or click (browsers block autoplay). Play UI sounds through one AudioBus.playUi(event) helper; never create a new AudioContext per sound."
}
