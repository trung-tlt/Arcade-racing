{
  "name": "voltline",
  "private": true,
  "version": "0.0.0",
  "description": "VOLTLINE: a browser 3D arcade combat racer (three.js + Rapier) with online multiplayer",
  "license": "MIT",
  "author": "Trung Tran",
  "homepage": "https://racing.craftmann.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trung-tlt/Arcade-racing.git"
  },
  "bugs": {
    "url": "https://github.com/trung-tlt/Arcade-racing/issues"
  },
  "keywords": [
    "racing-game",
    "arcade",
    "three.js",
    "rapier",
    "webgl",
    "multiplayer",
    "typescript",
    "vite"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint src tests && prettier --check src tests",
    "server:build": "esbuild src/server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-server/index.mjs",
    "server:start": "node dist-server/index.mjs",
    "netlab": "node scripts/netlab/run.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "three": "^0.187.0",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/stats.js": "^0.17.4",
    "@types/three": "^0.187.0",
    "@types/ws": "^8.18.2",
    "eslint": "^9.39.5",
    "lil-gui": "^0.21.0",
    "prettier": "^3.10.1",
    "stats.js": "^0.17.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^7.3.8",
    "vitest": "^3.2.7"
  }
}
