# /etc/voltline/server.env (mode 640, owner root:voltline). One KEY=value per line, no quotes, no export.
# The server is plain WebSocket on loopback; Caddy terminates TLS in front of it.
PORT=8080
HOST=127.0.0.1
# Rooms the process will open (6 humans each). Past the cap, create/quick-match are refused and players wait in the lobby.
# 12 is the conservative default measured for a 2 vCPU VM; see docs/multiplayer-release-plan.md section 19.
MAX_ROOMS=12
# Seconds the rematch vote runs on the results screen.
REMATCH_SEC=30
# debug | info | warn | error | silent. One JSON object per line on stdout (journald).
LOG_LEVEL=info
# Connections per remote IP. Behind Caddy every client arrives from 127.0.0.1, so this must be large (or the 9th player
# in the whole game is refused); until the server reads X-Forwarded-For, per-IP limiting is not effective here.
TRUST_PROXY=1
LEGACY_JOIN=0
NODE_ENV=production
